---
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@fontsource-variable/dm-sans/index.css';
import { business, services, towns, svcUrl } from '../data/site.js';
const { title, description, schema = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: business.name,
  telephone: business.phone,
  email: business.email,
  url: Astro.site.href,
  founder: { '@type': 'Person', name: business.owner },
  areaServed: business.towns.map((t) => ({ '@type': 'City', name: `${t}, Oregon` })),
  sameAs: Object.values(business.social),
};
const allSchema = [localBusiness, ...schema];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Test site: keep it out of Google so it never competes with the live site. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body>
    <p class="preview-bar">Preview site. A draft for Aleah to review, not the live website. <a href="/questions/">Aleah: quick questions for you</a></p>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href="/">
          <img src="/img/logo.png" alt="" width="129" height="138" />
          <span>{business.name}<small>Bend, Oregon</small></span>
        </a>
        <nav aria-label="Main">
          <details class="menu">
            <summary>Services</summary>
            <ul>
              {services.map((s) => <li><a href={svcUrl(s)}>{s.nav}<small>{s.from}</small></a></li>)}
            </ul>
          </details>
          <details class="menu">
            <summary>Areas</summary>
            <ul>
              <li><a href="/central-oregon/">All of Central Oregon</a></li>
              {towns.map((t) => <li><a href={`/${t.slug}/`}>{t.name}<small>{t.min ? `${t.min} min` : 'home base'}</small></a></li>)}
            </ul>
          </details>
          <a href="/about/">About</a>
          <a class="btn small" href={business.booking}>Free consultation</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <img src="/img/logo.png" alt="Innate Doula Care logo: a tree with deep roots" width="129" height="138" class="footer-logo" />
          <p class="footer-brand">{business.name}</p>
          <p>Full spectrum doula care across Central Oregon. On call for clients 24 hours a day.</p>
          <p><a href={business.phoneHref}>{business.phone}</a><br /><a href={`mailto:${business.email}`}>{business.email}</a></p>
        </div>
        <div>
          <p class="label">Services</p>
          <ul>{services.map((s) => <li><a href={svcUrl(s)}>{s.nav} in Bend</a></li>)}</ul>
        </div>
        <div>
          <p class="label">Areas served</p>
          <ul>
            {towns.map((t) => <li><a href={`/${t.slug}/`}>{t.name}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="label">Follow</p>
          <ul>{Object.entries(business.social).map(([k, v]) => <li><a href={v}>{k}</a></li>)}</ul>
          <p class="soft" style="font-size:13.5px">Stock photos from Unsplash, standing in until Aleah's own.</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Direction: quiet and professional. Warm paper, pine ink, one deep teal for actions, clay used sparingly.
     Central Oregon shows up as fine line work: an elevation profile of the Cascades, contour lines, a survey-style map. */
  :root {
    --bg: #fcfbf8; --panel: #f0f4ee; --fg: #223b38; --soft: #55625e; --line: #dfe3da;
    --river: #2f7a74; --clay: #a05a36; --field: #ffffff; --on-dark: #ffffff; --tint: #e3ece6;
    --display: 'Newsreader Variable', 'Iowan Old Style', Georgia, serif;
    --body: 'DM Sans Variable', 'Helvetica Neue', Arial, sans-serif;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--body); font-size: 17.5px; line-height: 1.6; }
  img { max-width: 100%; height: auto; display: block; }
  a { color: var(--river); text-underline-offset: 3px; text-decoration-thickness: 1px; }
  h1, h2, h3 { font-family: var(--display); font-weight: 400; line-height: 1.1; margin: 0; text-wrap: balance; letter-spacing: -0.012em; }
  h1 { font-size: clamp(40px, 5.6vw, 68px); }
  h2 { font-size: clamp(29px, 3.6vw, 42px); }
  h3 { font-size: 24px; }
  p { margin: 0; }
  ul { margin: 0; padding-left: 20px; }
  [hidden] { display: none !important; }
  .wrap { max-width: 1140px; margin-inline: auto; padding-inline: 22px; }
  .narrow { max-width: 760px; }
  .stack { display: flex; flex-direction: column; gap: 20px; }
  .section { padding-block: clamp(52px, 7vw, 92px); }
  .section.alt { background: var(--panel); }
  .eyebrow, .label { font-size: 12.5px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--clay); }
  .eyebrow a { color: inherit; }
  .lead { font-size: clamp(19px, 1.9vw, 21.5px); color: var(--soft); line-height: 1.55; }
  .soft { color: var(--soft); }
  .btn { display: inline-block; background: var(--river); color: var(--on-dark); text-decoration: none; font: inherit; font-weight: 600; padding: 13px 22px; border-radius: 6px; border: 1px solid var(--river); cursor: pointer; }
  .btn:hover { background: var(--fg); border-color: var(--fg); color: #fff; }
  .btn.small { padding: 8px 16px; font-size: 15.5px; }
  .btn.ghost { background: transparent; color: var(--fg); border-color: var(--fg); }
  .btn.ghost:hover { background: var(--fg); color: var(--bg); }
  .btn-row { display: flex; flex-wrap: wrap; gap: 12px 18px; align-items: center; }
  a:focus-visible, .btn:focus-visible, summary:focus-visible { outline: 2px solid var(--clay); outline-offset: 3px; }

  .preview-bar { background: var(--tint); color: var(--fg); font-size: 14px; text-align: center; padding: 7px 16px; }
  .preview-bar a { color: var(--fg); font-weight: 600; }
  .site-header { background: var(--bg); border-bottom: 1px solid var(--line); }
  .header-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 24px; padding-block: 10px; }
  .brand { display: flex; align-items: center; gap: 12px; color: var(--fg); text-decoration: none; }
  .brand img { width: 58px; height: auto; }
  .brand span { font-family: var(--display); font-size: 25px; line-height: 1.05; display: flex; flex-direction: column; letter-spacing: -0.01em; }
  .footer-logo { width: 120px; height: auto; align-self: flex-start; }
  .brand small { font-family: var(--body); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--soft); }
  nav { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 26px; font-weight: 500; font-size: 16.5px; }
  nav > a:not(.btn) { color: var(--fg); text-decoration: none; }
  nav > a:not(.btn):hover, .menu summary:hover { color: var(--river); }
  .menu { position: relative; }
  .menu summary { cursor: pointer; list-style: none; }
  .menu summary::after { content: ''; display: inline-block; width: 6px; height: 6px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: rotate(45deg) translateY(-3px); margin-left: 8px; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu ul { position: absolute; left: -12px; top: calc(100% + 12px); z-index: 10; background: var(--field); border: 1px solid var(--line); list-style: none; padding: 6px; min-width: 280px; box-shadow: 0 16px 40px rgba(23, 48, 46, 0.12); }
  .menu li a { display: flex; justify-content: space-between; gap: 16px; padding: 9px 12px; color: var(--fg); text-decoration: none; }
  .menu li a small { color: var(--soft); white-space: nowrap; }
  .menu li a:hover { background: var(--panel); }

  .topo { position: relative; isolation: isolate; }
  .topo::before { content: ''; position: absolute; inset: 0; z-index: -1; background: url('/img/topo.svg') center / cover no-repeat; opacity: 0.09; pointer-events: none; }

  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); border-block: 1px solid var(--line); }
  .facts.tight { grid-template-columns: repeat(3, 1fr); }
  .facts > div { padding: 16px 20px 16px 0; display: flex; flex-direction: column; gap: 3px; }
  .facts b { font-family: var(--display); font-weight: 400; font-size: 24px; line-height: 1.2; }
  .facts span { font-size: 12px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--soft); }

  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: clamp(32px, 5vw, 76px); align-items: start; }
  .checks { list-style: none; padding: 0; display: flex; flex-direction: column; }
  .checks li { padding: 11px 0 11px 26px; position: relative; border-top: 1px solid var(--line); }
  .checks li::before { content: ''; position: absolute; left: 2px; top: 1.15em; width: 11px; height: 6px; border-left: 1.5px solid var(--river); border-bottom: 1.5px solid var(--river); transform: rotate(-45deg); }
  .steps, .plain-list { list-style: none; padding: 0; display: flex; flex-direction: column; counter-reset: step; }
  .steps li { border-top: 1px solid var(--line); padding-block: 16px; display: grid; grid-template-columns: 40px 1fr; gap: 2px 8px; counter-increment: step; }
  .steps li::before { content: counter(step, decimal-leading-zero); font-size: 13px; font-weight: 600; letter-spacing: 0.08em; color: var(--clay); padding-top: 5px; grid-row: span 2; }
  .steps b, .plain-list b { font-size: 19px; font-weight: 600; }
  .steps span { color: var(--soft); grid-column: 2; }
  .plain-list li { border-top: 1px solid var(--line); padding-block: 15px; display: flex; flex-direction: column; gap: 2px; }

  .price-card { background: var(--field); border: 1px solid var(--line); padding: clamp(22px, 3vw, 34px); display: flex; flex-direction: column; gap: 16px; }
  .price-table { width: 100%; border-collapse: collapse; }
  .price-table td { padding: 13px 0; border-top: 1px solid var(--line); vertical-align: top; }
  .price-table tr:first-child td { border-top: 0; padding-top: 0; }
  .price-table td:last-child { text-align: right; font-family: var(--display); font-size: 21px; white-space: nowrap; padding-left: 16px; }
  .price-table small { display: block; color: var(--soft); font-size: 15px; }

  .faq details { border-top: 1px solid var(--line); padding-block: 16px; }
  .faq details:last-child { border-bottom: 1px solid var(--line); }
  .faq summary { cursor: pointer; font-weight: 600; font-size: 19px; }
  .faq p { margin-top: 8px; color: var(--soft); max-width: 62ch; }

  .rows { list-style: none; padding: 0; border-bottom: 1px solid var(--line); }
  .rows li { border-top: 1px solid var(--line); }
  .rows a { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr) auto; gap: 6px 28px; align-items: baseline; padding: 20px 4px; color: var(--fg); text-decoration: none; }
  .rows h3 { font-size: 25px; }
  .rows p { color: var(--soft); font-size: 16.5px; }
  .rows .price { font-size: 15px; font-weight: 600; color: var(--fg); white-space: nowrap; text-align: right; }
  .rows a:hover { background: var(--panel); }
  .rows a:hover h3 { color: var(--river); }
  @media (max-width: 720px) { .rows a { grid-template-columns: 1fr auto; } .rows p { grid-column: 1 / -1; grid-row: 2; } }

  .town-links { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 0 28px; }
  .town-links li { border-top: 1px solid var(--line); }
  .town-links a, .town-links span.here { display: flex; flex-direction: column; padding-block: 12px; color: var(--fg); text-decoration: none; }
  .town-links b { font-family: var(--display); font-weight: 400; font-size: 23px; }
  .town-links small { color: var(--soft); font-size: 14.5px; }
  .town-links a:hover b { color: var(--river); }

  .photo-slot { background: var(--panel); border: 1px solid var(--line); display: flex; align-items: flex-end; padding: 20px; color: var(--soft); font-size: 14.5px; }
  .note-box { border: 1px dashed var(--line); padding: 18px 20px; color: var(--soft); font-size: 15.5px; }
  .cta { background: var(--tint); }
  .cta .lead { color: var(--soft); }

  .site-footer { border-top: 1px solid var(--line); padding-block: 56px; font-size: 15.5px; }
  .footer-brand { font-family: var(--display); font-size: 25px; }
  .footer-grid { display: grid; grid-template-columns: 1.4fr 1.2fr 1fr 0.8fr; gap: 36px; }
  @media (max-width: 860px) { .footer-grid { grid-template-columns: 1fr 1fr; } }
  .footer-grid > div { display: flex; flex-direction: column; gap: 10px; }
  .site-footer ul { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .site-footer a { color: var(--fg); }
</style>
