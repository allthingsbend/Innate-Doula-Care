---
// Hand-drawn style map of the service area. Positions come from real coordinates in site.js.
import { towns } from '../data/site.js';
const X = (lon) => ((lon + 121.85) / 1.1) * 460 + 30;
const Y = (lat) => ((44.72 - lat) / 1.12) * 600 + 24;
const pt = (lat, lon) => `${X(lon).toFixed(0)},${Y(lat).toFixed(0)}`;
const t = Object.fromEntries(towns.map((x) => [x.name, x]));
const p = (n) => pt(t[n].lat, t[n].lon);
const hwy97 = [p('Madras'), p('Terrebonne'), p('Redmond'), p('Bend'), pt(43.884, -121.4), p('La Pine')].join(' ');
const hwy20 = [p('Sisters'), p('Bend')].join(' ');
const hwy126 = [p('Sisters'), p('Redmond'), p('Prineville')].join(' ');
const culver = [p('Culver'), pt(44.5, -121.16)].join(' ');
const sunriver = [p('Sunriver'), pt(43.884, -121.4)].join(' ');
const peaks = [
  { n: 'Three Sisters', lat: 44.12, lon: -121.77, s: 1.25 },
  { n: 'Mt. Bachelor', lat: 43.98, lon: -121.69, s: 1 },
  { n: 'Black Butte', lat: 44.4, lon: -121.64, s: 0.9 },
];
const left = new Set(['Culver', 'Sunriver', 'Sisters']);
const below = new Set(['Redmond']);
// Drive times live in the list beside the map, so labels here stay to one line.
---
<svg class="area-map" viewBox="0 0 590 650" role="img" aria-label="Map of Central Oregon showing the towns served from Bend: Redmond, Sisters, Sunriver, Terrebonne, La Pine, Prineville, Culver and Madras">
  <rect x="1" y="1" width="588" height="648" rx="14" fill="var(--field)" stroke="var(--line)" />
  <!-- Deschutes River, loosely -->
  <path d={`M${pt(43.72, -121.52)} C${pt(43.85, -121.47)} ${pt(43.98, -121.36)} ${pt(44.06, -121.33)} S${pt(44.3, -121.28)} ${pt(44.42, -121.24)} S${pt(44.6, -121.3)} ${pt(44.7, -121.24)}`} fill="none" stroke="var(--river)" stroke-width="5" stroke-linecap="round" opacity="0.35" />
  <text x={X(-121.64)} y={Y(43.79)} class="hand" fill="var(--river)" font-size="20">Deschutes River</text>
  <g fill="none" stroke="var(--fg)" stroke-width="2.5" stroke-dasharray="2 7" stroke-linecap="round" opacity="0.7">
    <polyline points={hwy97} /><polyline points={hwy20} /><polyline points={hwy126} /><polyline points={culver} /><polyline points={sunriver} />
  </g>
  {peaks.map((k) => (
    <g transform={`translate(${X(k.lon)},${Y(k.lat)}) scale(${k.s})`}>
      {k.n === 'Three Sisters'
        ? <path d="M-34,10 L-22,-12 L-12,4 L0,-20 L12,4 L22,-10 L34,10 Z" fill="var(--panel)" stroke="var(--fg)" stroke-width="2" stroke-linejoin="round" />
        : <path d="M-18,10 L0,-16 L18,10 Z" fill="var(--panel)" stroke="var(--fg)" stroke-width="2" stroke-linejoin="round" />}
      <text x="0" y="30" text-anchor="middle" class="hand" font-size={18 / k.s} fill="var(--soft)">{k.n}</text>
    </g>
  ))}
  <text x={X(-121.1)} y={Y(44.385)} class="hand" font-size="18" fill="var(--rust)">Smith Rock</text>
  <text x={X(-121.2)} y={Y(43.76)} class="hand" font-size="18" fill="var(--soft)">Newberry Crater</text>
  {towns.map((x) => {
    const cx = X(x.lon), cy = Y(x.lat);
    const home = x.min === 0;
    const anchor = left.has(x.name) ? 'end' : 'start';
    const tx = left.has(x.name) ? cx - 14 : below.has(x.name) ? cx + 8 : cx + 14;
    const ty = below.has(x.name) ? cy + 28 : cy + 6;
    return (
      <g>
        {home && <circle cx={cx} cy={cy} r="17" fill="none" stroke="var(--rust)" stroke-width="2" />}
        <circle cx={cx} cy={cy} r={home ? 9 : 6.5} fill={home ? 'var(--rust)' : 'var(--river)'} />
        <text x={home ? cx - 24 : tx} y={home ? cy + 6 : ty} text-anchor={home ? 'end' : anchor} font-size={home ? 24 : 19} font-weight="700" fill="var(--fg)">{x.name}</text>
        {home && <text x={cx - 24} y={cy + 26} text-anchor="end" class="hand" font-size="20" fill="var(--rust)">home base</text>}
      </g>
    );
  })}
  <g transform="translate(540,600)"><path d="M0,14 L0,-14 M-6,-6 L0,-14 L6,-6" fill="none" stroke="var(--fg)" stroke-width="2" stroke-linecap="round" /><text x="0" y="32" text-anchor="middle" font-size="13" font-weight="700" fill="var(--fg)">N</text></g>
</svg>

<style>
  .area-map { width: 100%; max-width: 590px; height: auto; font-family: var(--body); }
</style>
