---
// Service-area map drawn from the real coordinates in site.js.
// Pass `highlight="Redmond"` to ring one town (used on the town pages).
import { towns } from '../data/site.js';
const { highlight = '' } = Astro.props;
const X = (lon) => ((lon + 121.85) / 1.1) * 460 + 30;
const Y = (lat) => ((44.72 - lat) / 1.12) * 600 + 24;
const pt = (lat, lon) => `${X(lon).toFixed(0)},${Y(lat).toFixed(0)}`;
const t = Object.fromEntries(towns.map((x) => [x.name, x]));
const p = (n) => pt(t[n].lat, t[n].lon);
const roads = [
  [p('Madras'), p('Terrebonne'), p('Redmond'), p('Bend'), pt(43.884, -121.4), p('La Pine')],
  [p('Sisters'), p('Bend')],
  [p('Sisters'), p('Redmond'), p('Prineville')],
  [p('Culver'), pt(44.5, -121.16)],
  [p('Sunriver'), pt(43.884, -121.4)],
].map((r) => r.join(' '));
const peaks = [
  { n: 'Three Sisters', lat: 44.12, lon: -121.77 },
  { n: 'Mt. Bachelor', lat: 43.98, lon: -121.69 },
  { n: 'Black Butte', lat: 44.4, lon: -121.64 },
];
const left = new Set(['Culver', 'Sunriver', 'Sisters']);
const below = new Set(['Redmond']);
---
<svg class="area-map" viewBox="0 0 590 650" role="img" aria-label={`Map of Central Oregon showing the towns served from Bend${highlight ? `, with ${highlight} highlighted` : ''}`}>
  <rect x="0.5" y="0.5" width="589" height="649" fill="var(--field)" stroke="var(--line)" />
  <path d={`M${pt(43.72, -121.52)} C${pt(43.85, -121.47)} ${pt(43.98, -121.36)} ${pt(44.06, -121.33)} S${pt(44.3, -121.28)} ${pt(44.42, -121.24)} S${pt(44.6, -121.3)} ${pt(44.7, -121.24)}`} fill="none" stroke="var(--river)" stroke-width="2" opacity="0.5" />
  <text x={X(-121.6)} y={Y(44.665)} class="m-note" fill="var(--river)">Deschutes River</text>
  <g fill="none" stroke="var(--fg)" stroke-width="1" opacity="0.55">
    {roads.map((r) => <polyline points={r} />)}
  </g>
  {peaks.map((k) => (
    <g transform={`translate(${X(k.lon)},${Y(k.lat)})`}>
      <path d={k.n === 'Three Sisters' ? 'M-26,8 L-16,-8 L-8,2 L0,-14 L8,2 L16,-7 L26,8' : 'M-13,8 L0,-11 L13,8'} fill="none" stroke="var(--fg)" stroke-width="1.2" stroke-linejoin="round" opacity="0.7" />
      <text x="0" y="24" text-anchor="middle" class="m-note" fill="var(--soft)">{k.n}</text>
    </g>
  ))}
  <text x={X(-121.1)} y={Y(44.385)} class="m-note" fill="var(--soft)">Smith Rock</text>
  <text x={X(-121.2)} y={Y(43.76)} class="m-note" fill="var(--soft)">Newberry Crater</text>
  {towns.map((x) => {
    const cx = X(x.lon), cy = Y(x.lat);
    const home = x.min === 0;
    const hot = x.name === highlight;
    const anchor = home || left.has(x.name) ? 'end' : 'start';
    const tx = home ? cx - 18 : left.has(x.name) ? cx - 12 : below.has(x.name) ? cx + 8 : cx + 12;
    const ty = home ? cy + 6 : below.has(x.name) ? cy + 24 : cy + 5;
    return (
      <g>
        {(home || hot) && <circle cx={cx} cy={cy} r={hot ? 15 : 12} fill="none" stroke={hot ? 'var(--clay)' : 'var(--fg)'} stroke-width="1.4" />}
        <circle cx={cx} cy={cy} r={home ? 6 : 4.5} fill={hot ? 'var(--clay)' : 'var(--fg)'} />
        <text x={tx} y={ty} text-anchor={anchor} class={home ? 'm-home' : 'm-town'} fill={hot ? 'var(--clay)' : 'var(--fg)'}>{x.name}</text>
      </g>
    );
  })}
  <g transform="translate(548,604)" opacity="0.7"><path d="M0,12 L0,-12 M-5,-5 L0,-12 L5,-5" fill="none" stroke="var(--fg)" stroke-width="1.2" /><text x="0" y="28" text-anchor="middle" class="m-note" fill="var(--fg)">N</text></g>
</svg>

<style>
  .area-map { width: 100%; max-width: 590px; height: auto; font-family: var(--body); }
  .m-town { font-size: 16px; font-weight: 600; }
  .m-home { font-family: var(--display); font-size: 26px; }
  .m-note { font-family: var(--display); font-style: italic; font-size: 14.5px; }
</style>
