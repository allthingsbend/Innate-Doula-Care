  <path d="M128,196 C150,60 280,40 322,196" fill="none" stroke="#10312F" stroke-width="13" stroke-linecap="round" />
  <circle cx="128" cy="196" r="12" fill="#10312F" /><circle cx="322" cy="196" r="12" fill="#10312F" />
  <!-- checked tag -->
  <g transform="translate(346,70) rotate(10)">
    <line x1="-22" y1="34" x2="-6" y2="16" stroke="var(--fg)" stroke-width="2" />
    <rect x="-8" y="-22" width="70" height="44" rx="8" fill="var(--field)" stroke="var(--fg)" stroke-width="2" />
