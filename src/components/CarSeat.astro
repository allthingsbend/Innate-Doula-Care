  <!-- base -->
  <path d="M70,262 C70,240 86,232 110,232 L310,232 C338,232 350,244 350,262 L350,270 C350,278 344,284 336,284 L84,284 C76,284 70,278 70,270 Z" fill="#10312F" />
  <rect x="92" y="246" width="236" height="10" rx="5" fill="#1F6F78" />
  <!-- shell -->
  <path d="M96,232 C70,170 84,92 150,64 C176,53 204,60 210,84 L238,178 C244,198 262,206 286,206 L318,206 C338,206 346,224 334,232 Z" fill="#1F6F78" />
  <!-- padding -->
  <path d="M120,222 C102,172 112,112 158,90 C174,82 188,88 192,104 L216,186 C222,206 240,218 262,218 L300,218 C306,218 306,222 300,222 Z" fill="#EDE4D3" />
