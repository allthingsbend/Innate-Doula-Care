---
// "Get started" band at the bottom of every page: every way to reach Aleah, plus a short request form.
// The form remembers which service and town page the visitor was on.
import { business, services, towns } from '../data/site.js';
const { service = '', town = '' } = Astro.props;
---
<section class="section get-started" id="get-started">
  <div class="wrap gs-grid">
    <div class="stack">
      <p class="eyebrow">Get started</p>
      <h2>Pick whatever is easiest for you</h2>
      <p class="lead">Every option reaches Aleah directly. The first conversation is free.</p>
      <ul class="ways">
        <li><a href={business.booking}><b>Book a free consultation</b><span>Pick a time online</span></a></li>
        <li><a href={business.phoneHref}><b>Call {business.phone}</b><span>Office hours 8 am to 5 pm</span></a></li>
        <li><a href={business.smsHref}><b>Text {business.phone}</b><span>Good for a quick question</span></a></li>
        <li><a href={`mailto:${business.email}`}><b>Email</b><span>{business.email}</span></a></li>
      </ul>
      <p class="soft" style="font-size:15px">Serving Bend, Redmond, Sisters, Sunriver, La Pine, Prineville, Madras and the rest of Central Oregon. On call for current clients 24 hours a day.</p>
    </div>
    <form class="request stack" id="request-form" novalidate>
      <h3>Or send a quick request</h3>
      <div class="pair">
        <label>What do you need help with?
          <select id="r-service" name="service">
            <option value="">Not sure yet</option>
            {services.map((s) => <option value={s.nav} selected={s.path === service}>{s.nav}</option>)}
            <option value="More than one thing">More than one thing</option>
          </select>
        </label>
        <label>Where are you?
          <select id="r-town" name="town">
            <option value="">Choose a town</option>
            {towns.map((t) => <option value={t.name} selected={t.name === town}>{t.name}</option>)}
            <option value="Somewhere else">Somewhere else</option>
          </select>
        </label>
      </div>
      <label>Your name<input type="text" id="r-name" name="name" required autocomplete="name" /></label>
      <div class="pair">
        <label>Phone<input type="tel" id="r-phone" name="phone" autocomplete="tel" /></label>
        <label>Email<input type="email" id="r-email" name="email" autocomplete="email" /></label>
      </div>
      <label>Estimated due date, if applicable<input type="text" id="r-due" name="due" /></label>
      <label>Anything you want me to know (optional)<textarea id="r-message" name="message" rows="3"></textarea></label>
      <input type="text" id="r-website" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
      <button type="submit" class="btn">Send my request</button>
      <p id="r-status" role="status" aria-live="polite" hidden></p>
      <p class="soft" style="font-size:14px">Phone or email, either one is fine. Preview site: requests sent here go to Mitch, not to Aleah.</p>
    </form>
  </div>
</section>

<style>
  .get-started { background: var(--tint); border-top: 1px solid var(--line); }
  .gs-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .ways { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .ways a { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 16px; background: var(--field); border: 1px solid var(--line); border-radius: 6px; padding: 15px 18px; color: var(--fg); text-decoration: none; }
  .ways a:hover { border-color: var(--river); }
  .ways li:first-child a { background: var(--river); border-color: var(--river); color: #fff; }
  .ways li:first-child a:hover { background: var(--fg); border-color: var(--fg); }
  .ways b { font-size: 18px; font-weight: 600; }
  .ways span { font-size: 15px; opacity: 0.8; }
  .request { background: var(--field); border: 1px solid var(--line); padding: clamp(20px, 3vw, 32px); gap: 14px; }
  .request h3 { font-size: 26px; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .request label { display: flex; flex-direction: column; gap: 5px; font-weight: 600; font-size: 15.5px; }
  .request input, .request textarea, .request select { font: inherit; font-weight: 400; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 4px; padding: 11px 13px; width: 100%; }
  .request input:focus-visible, .request textarea:focus-visible, .request select:focus-visible { outline: 2px solid var(--river); outline-offset: 1px; }
  .request .btn { align-self: stretch; text-align: center; padding-block: 15px; font-size: 18px; }
  #r-status { font-weight: 600; }
  @media (max-width: 860px) { .gs-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 480px) { .pair { grid-template-columns: 1fr; } }
</style>

<script is:inline>
  (function () {
    var form = document.getElementById('request-form');
    var status = document.getElementById('r-status');
    function say(t) { status.textContent = t; status.hidden = !t; }
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var v = function (id) { return document.getElementById(id).value.trim(); };
      if (!v('r-name')) { say('Please add your name.'); return; }
      if (!v('r-phone') && !v('r-email')) { say('Please add a phone number or an email so I can reply.'); return; }
      say('Sending...');
      fetch('/api/contact', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ service: v('r-service'), town: v('r-town'), name: v('r-name'), phone: v('r-phone'), email: v('r-email'), due: v('r-due'), message: v('r-message'), website: v('r-website'), page: location.pathname }),
      }).then(function (r) {
        if (!r.ok) throw new Error('bad');
        form.reset();
        say('Thank you! Your request was sent.');
      }).catch(function () { say('That did not send. Please call or text (541) 280-4048 instead.'); });
    });
  })();
</script>
