---
import Base from '../layouts/Base.astro';
import AreaMap from '../components/AreaMap.astro';
import Ridgeline from '../components/Ridgeline.astro';
import Cta from '../components/Cta.astro';
import { business, services, towns, svcUrl, photos, photoUrl, scenery } from '../data/site.js';
---
<Base
  title="Areas Served in Central Oregon | Bend, Redmond, Sisters & More | Innate Doula Care"
  description="Innate Doula Care provides in-home doula care, lactation support and car seat help across Central Oregon: Bend, Redmond, Sisters, Sunriver, La Pine, Prineville, Terrebonne, Culver and Madras."
>
  <section>
    <div class="wrap stack" style="padding-block: clamp(36px, 6vw, 76px) clamp(20px, 3vw, 40px)">
      <p class="eyebrow"><a href="/">Home</a> / Central Oregon</p>
      <h1 style="max-width:16ch">Where I work in Central Oregon</h1>
      <p class="lead" style="max-width:56ch">I come to you, from La Pine in the south up to Madras in the north.</p>
      <Cta />
    </div>
    <Ridgeline />
  </section>

  <section class="section">
    <div class="wrap two" style="align-items:center">
      <AreaMap />
      <div class="stack">
        <h2>Towns I serve in person</h2>
        <ul class="town-links">
          {towns.map((t) => <li><a href={`/${t.slug}/`}><b>{t.name}</b></a></li>)}
        </ul>
        <p>Visits happen in your home, at the hospital or at a birth center. Virtual support is available for families outside the area.</p>
        <p class="soft">Not sure if you are in range? Call or text <a href={business.phoneHref}>{business.phone}</a> and ask.</p>
      </div>
    </div>
  </section>

  <figure style="margin:0">
    <img src={photoUrl(photos.lake, 2000, 700)} alt={photos.lake.alt} width="2000" height="700" loading="lazy" style="width:100%;height:clamp(200px,30vw,420px);object-fit:cover;background:var(--panel)" />
  </figure>

  <section class="section alt">
    <div class="wrap stack">
      <div class="photo-row" style="margin-bottom:20px">
        {scenery.slice(0, 3).map((ph) => <img src={photoUrl(ph, 800, 600)} alt={ph.alt} width="800" height="600" loading="lazy" />)}
      </div>
      <p class="eyebrow">Available in every town</p>
      <ul class="rows">
        {services.map((s) => (
          <li><a href={svcUrl(s)}><h3>{s.nav}</h3><p>{s.summary}</p><span class="price">{s.from}</span></a></li>
        ))}
      </ul>
      <div class="note-box">
        <p><b>Note for Aleah and Mitch:</b> drive times are rough estimates to confirm. Every town has its own page, and seven of them have a page for each service.</p>
      </div>
    </div>
  </section>
</Base>
