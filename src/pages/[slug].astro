---
// One route for both page families: service pages ("car-seat-installation-bend")
// and town pages ("doula-redmond-oregon").
import Base from '../layouts/Base.astro';
import AreaMap from '../components/AreaMap.astro';
import { business, services, towns, townPages } from '../data/site.js';

export function getStaticPaths() {
  return [
    ...services.map((s) => ({ params: { slug: s.slug }, props: { s } })),
    ...townPages.map((t) => ({ params: { slug: t.slug }, props: { t } })),
  ];
}
const { s, t } = Astro.props;

// ----- service page data -----
const faqs = s
  ? s.faqs
  : [
      { q: `Do you travel to ${t.name}?`, a: `Yes. ${t.name} is about ${t.min} minutes from my home base in Bend, and I come to you for prenatal, postpartum, lactation and car seat visits.` },
      ...(t.faq ? [t.faq] : []),
      { q: `Is doula care in ${t.name} covered by the Oregon Health Plan?`, a: 'Yes. I am an OHP-approved doula, and OHP members can receive birth doula care at no out-of-pocket cost. HSA and FSA are also accepted.' },
      { q: 'Do you offer virtual support?', a: 'Yes. Virtual prenatal sessions, lactation visits and car seat checks are available if that suits you better.' },
    ];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: s ? s.title : `Doula services in ${t.name}, Oregon`,
  description: s ? s.description : `Birth and postpartum doula care, lactation support and car seat help in ${t.name}, Oregon.`,
  provider: { '@type': 'LocalBusiness', name: business.name, telephone: business.phone },
  areaServed: s ? business.towns.map((x) => `${x}, Oregon`) : `${t.name}, Oregon`,
};
const others = s ? services.filter((o) => o.slug !== s.slug).slice(0, 4) : [];
const ordered = s && ['car-seat-installation-bend', 'placenta-encapsulation-bend', 'abortion-doula-support-bend'].includes(s.slug);
const title = s ? `${s.title} | ${business.name}` : `Doula in ${t.name}, Oregon | Birth, Postpartum & Car Seat Help | ${business.name}`;
const description = s
  ? s.description
  : `Doula care in ${t.name}, Oregon from Innate Doula Care: birth and postpartum support, lactation help, placenta services and in-home car seat checks. About ${t.min} minutes from Bend. OHP accepted.`;
const nearby = t ? townPages.filter((x) => x.name !== t.name) : [];
---
<Base title={title} description={description} schema={[serviceSchema, faqSchema]}>
  {s && (
    <>
      <section class="page-hero topo">
        <div class="wrap stack">
          <p class="eyebrow"><a href="/#services">Services</a> · Bend and Central Oregon</p>
          <h1>{s.h1}</h1>
          <p class="lead">{s.summary}</p>
          <div class="facts">
            {s.facts.map(([k, v]) => <div><span>{k}</span><b>{v}</b></div>)}
          </div>
          <div class="btn-row">
            <a class="btn" href={business.booking}>Book a free consultation</a>
            <span>or call or text <a href={business.phoneHref}>{business.phone}</a></span>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap two">
          <div class="stack">
            {s.intro.map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}
            <h2>{s.includesTitle}</h2>
            <ul class={ordered ? 'steps' : 'plain-list'}>
              {s.includes.map(([k, d]) => <li><b>{k}</b><span class="soft">{d}</span></li>)}
            </ul>
          </div>
          <aside class="price-card sticky">
            <p class="eyebrow">Pricing</p>
            <table class="price-table">
              <tbody>
                {s.pricing.map(([name, price, note]) => (
                  <tr>
                    <td>{name}{note && <small>{note}</small>}</td>
                    <td>{price}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="soft" style="font-size:15.5px">HSA and FSA accepted. A superbill is available for insurance.</p>
            <a class="btn" href={business.booking}>Book a free consultation</a>
          </aside>
        </div>
      </section>

      <section class="section alt">
        <div class="wrap two">
          <div class="stack">
            <p class="eyebrow">Good to know</p>
            <h2>Common questions</h2>
          </div>
          <div class="faq">
            {faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap stack">
          <p class="eyebrow">Areas served</p>
          <h2>{s.nav} across Central Oregon</h2>
          <ul class="town-links">
            <li><span class="here"><b>Bend</b><small>home base</small></span></li>
            {townPages.map((x) => <li><a href={`/${x.slug}/`}><b>{x.name}</b><small>about {x.min} min from Bend</small></a></li>)}
          </ul>
        </div>
      </section>

      <section class="section alt">
        <div class="wrap stack">
          <p class="eyebrow">Other services</p>
          <ul class="rows">
            {others.map((o) => (
              <li><a href={`/${o.slug}/`}><h3>{o.nav}</h3><p>{o.summary}</p><span class="price">{o.from}</span></a></li>
            ))}
          </ul>
        </div>
      </section>
    </>
  )}

  {t && (
    <>
      <section class="page-hero topo">
        <div class="wrap stack">
          <p class="eyebrow"><a href="/service-area/">Areas served</a> · Central Oregon</p>
          <h1>Doula in {t.name}, Oregon</h1>
          <p class="lead">Birth and postpartum doula care, lactation support and car seat help for {t.name} families, from a state-certified doula based in Bend.</p>
          <div class="facts">
            <div><span>From Bend</span><b>About {t.min} minutes</b></div>
            <div><span>Visits</span><b>At your home in {t.name}</b></div>
            <div><span>Oregon Health Plan</span><b>Accepted</b></div>
          </div>
          <div class="btn-row">
            <a class="btn" href={business.booking}>Book a free consultation</a>
            <span>or call or text <a href={business.phoneHref}>{business.phone}</a></span>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="wrap two" style="align-items:center">
          <div class="stack">
            <p class="eyebrow">{t.name}</p>
            <h2>Care that comes to you, {t.where}</h2>
            <p class="lead">{t.note}</p>
            <p>I am on call for birth clients 24 hours a day, and every prenatal and postpartum visit happens where you are most comfortable.</p>
            <div class="note-box">
              <p><b>Note for Aleah:</b> a sentence or two about families you have supported in {t.name}, or local providers you work with, would make this page much stronger.</p>
            </div>
          </div>
          <AreaMap highlight={t.name} />
        </div>
      </section>

      <section class="section alt">
        <div class="wrap stack">
          <p class="eyebrow">Services in {t.name}</p>
          <h2>What I offer {t.name} families</h2>
          <ul class="rows">
            {services.map((o) => (
              <li><a href={`/${o.slug}/`}><h3>{o.nav}</h3><p>{o.summary}</p><span class="price">{o.from}</span></a></li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section">
        <div class="wrap two">
          <div class="stack">
            <p class="eyebrow">Good to know</p>
            <h2>Questions from {t.name} families</h2>
          </div>
          <div class="faq">
            {faqs.map((f, i) => (
              <details open={i === 0}>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section alt">
        <div class="wrap stack">
          <p class="eyebrow">Nearby</p>
          <ul class="town-links">
            <li><a href="/"><b>Bend</b><small>home base</small></a></li>
            {nearby.map((x) => <li><a href={`/${x.slug}/`}><b>{x.name}</b><small>about {x.min} min from Bend</small></a></li>)}
          </ul>
        </div>
      </section>
    </>
  )}
</Base>

<style>
  .page-hero { border-bottom: 1px solid var(--line); }
  .page-hero .wrap { padding-block: clamp(36px, 6vw, 76px); }
  .page-hero h1 { max-width: 18ch; }
  .page-hero .lead { max-width: 58ch; }
  .sticky { position: sticky; top: 20px; }
</style>
