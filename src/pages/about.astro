---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { business, about, photoUrl } from '../data/site.js';
---
<Base
  title={about.seoTitle}
  description={about.seoDescription}
>
  <section class="section">
    <div class="wrap two">
      <div class="stack">
        <p class="eyebrow">About</p>
        <h1>{about.heading}</h1>
        <p class="lead">{about.lead}</p>
        {about.paragraphs.map((p) => <p>{p}</p>)}
        <Cta />
      </div>
      <div class="stack">
        {about.portrait ? <img class="portrait" src={about.portrait} alt="Aleah Hancock" style="width:100%;object-fit:cover" /> : <div class="photo-slot portrait"><span>Photo: a portrait of Aleah goes here. People hire a person, so this is the most important image on the site.</span></div>}
        <p class="label">Certification, training and education</p>
        <ul class="checks small">
          {about.credentials.map((c) => <li>{c}</li>)}
        </ul>
      </div>
    </div>
  </section>
  <section class="section alt">
    <div class="wrap photo-row">
      {about.photos.map((ph) => <img src={photoUrl(ph, 800, 600)} alt={ph.alt} width="800" height="600" loading="lazy" />)}
    </div>
  </section>
</Base>

<style>
  .portrait { aspect-ratio: 4 / 5; max-width: 380px; }
</style>
