---
import Base from '../layouts/Base.astro';
import AreaMap from '../components/AreaMap.astro';
import { business, services, towns } from '../data/site.js';
---
<Base
  title="Doula Serving Central Oregon | Bend, Redmond, Sisters & More | Innate Doula Care"
  description="Innate Doula Care provides in-home doula care, lactation support and car seat help across Central Oregon: Bend, Redmond, Sisters, Sunriver, La Pine, Prineville, Terrebonne, Culver and Madras."
>
  <section>
    <div class="wrap stack" style="padding-block: clamp(24px, 4vw, 52px) clamp(24px, 3vw, 40px)">
      <p class="eyebrow">Service area</p>
      <h1 style="max-width:16ch">Doula care across Central Oregon</h1>
      <p class="lead">Based in Bend. I come to you, from La Pine up to Madras.</p>
    </div>
    <figure class="scene">
      <img src="/img/desert.jpg" width="1920" height="720" alt="Illustration of rust-colored rock spires above a river in the high desert" />
      <figcaption>Smith Rock country, north of Redmond</figcaption>
    </figure>
  </section>

  <section class="section">
    <div class="wrap two" style="align-items:center">
      <AreaMap />
      <div class="stack">
        <h2>Towns I serve in person</h2>
        <ul class="town-list">
          {towns.map((t) => <li><b>{t.name}</b><span>{t.min ? `about ${t.min} min from Bend` : 'home base'}</span></li>)}
        </ul>
        <p>Visits happen in your home, at the hospital or at a birth center. Virtual support is available for families outside the area.</p>
        <p class="soft">Not sure if you are in range? Call or text <a href={business.phoneHref}>{business.phone}</a> and ask.</p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap stack">
      <p class="eyebrow">Available in every town</p>
      <ul class="svc-list">
        {services.map((s) => (
          <li>
            <a href={`/${s.slug}/`}>
              <img src={`/img/t-${s.image}.jpg`} alt="" width="480" height="300" loading="lazy" />
              <div>
                <h3>{s.nav} <small>{s.from}</small></h3>
                <p>{s.summary}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <div class="placeholder">
        <p><b>Note for Aleah and Mitch:</b> this one page covers every town for now. Once we decide between town-by-town pages and one Central Oregon page per service, this is where that structure grows from. Drive times are rough estimates to confirm.</p>
      </div>
    </div>
  </section>
</Base>
