---
import Base from '../layouts/Base.astro';
import AreaMap from '../components/AreaMap.astro';
import Ridgeline from '../components/Ridgeline.astro';
import { business, services, townPages } from '../data/site.js';
---
<Base
  title="Doula Serving Central Oregon | Bend, Redmond, Sisters & More | Innate Doula Care"
  description="Innate Doula Care provides in-home doula care, lactation support and car seat help across Central Oregon: Bend, Redmond, Sisters, Sunriver, La Pine, Prineville, Terrebonne, Culver and Madras."
>
  <section>
    <div class="wrap stack" style="padding-block: clamp(36px, 6vw, 76px) clamp(20px, 3vw, 40px)">
      <p class="eyebrow">Areas served</p>
      <h1 style="max-width:16ch">Doula care across Central Oregon</h1>
      <p class="lead" style="max-width:56ch">Based in Bend. I come to you, from La Pine in the south up to Madras in the north.</p>
    </div>
    <Ridgeline />
  </section>

  <section class="section">
    <div class="wrap two" style="align-items:center">
      <AreaMap />
      <div class="stack">
        <h2>Towns I serve in person</h2>
        <ul class="town-links">
          <li><a href="/"><b>Bend</b><small>home base</small></a></li>
          {townPages.map((t) => <li><a href={`/${t.slug}/`}><b>{t.name}</b><small>about {t.min} min from Bend</small></a></li>)}
        </ul>
        <p>Visits happen in your home, at the hospital or at a birth center. Virtual support is available for families outside the area.</p>
        <p class="soft">Not sure if you are in range? Call or text <a href={business.phoneHref}>{business.phone}</a> and ask.</p>
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap stack">
      <p class="eyebrow">Available in every town</p>
      <ul class="rows">
        {services.map((s) => (
          <li><a href={`/${s.slug}/`}><h3>{s.nav}</h3><p>{s.summary}</p><span class="price">{s.from}</span></a></li>
        ))}
      </ul>
      <div class="note-box">
        <p><b>Note for Aleah and Mitch:</b> drive times are rough estimates to confirm. Each town now has its own page, linked above.</p>
      </div>
    </div>
  </section>
</Base>
