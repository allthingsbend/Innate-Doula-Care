---
import Base from '../layouts/Base.astro';
import AreaMap from '../components/AreaMap.astro';
import Ridgeline from '../components/Ridgeline.astro';
import { business, services, townPages } from '../data/site.js';
---
<Base
  title="Bend Doula | Innate Doula Care | Birth, Postpartum & Car Seat Help"
  description="Innate Doula Care is a full spectrum doula in Bend, Oregon: birth and postpartum doula care, lactation support, placenta services and in-home car seat installation help across Central Oregon."
>
  <section class="home-hero">
    <div class="wrap hero-grid">
      <div class="stack">
        <p class="eyebrow">Full spectrum doula · Bend, Oregon</p>
        <h1>Bend doula care for birth, postpartum and beyond</h1>
        <p class="lead">You can do hard things, and I am here to support you every step of the way. In your home, at the hospital, or anywhere in Central Oregon.</p>
        <div class="btn-row">
          <a class="btn" href={business.booking}>Book a free consultation</a>
          <a class="btn ghost" href="#services">Services and prices</a>
        </div>
        <p class="creds">OHP-approved doula · Certified Lactation Counselor · Child Passenger Safety Technician</p>
      </div>
      <div class="photo-slot portrait"><span>Photo: a portrait of Aleah goes here</span></div>
    </div>
    <Ridgeline />
  </section>

  <section class="section" id="services">
    <div class="wrap stack">
      <p class="eyebrow">Services</p>
      <h2>What I can help with</h2>
      <ul class="rows">
        {services.map((s) => (
          <li>
            <a href={`/${s.slug}/`}>
              <h3>{s.nav}</h3>
              <p>{s.summary}</p>
              <span class="price">{s.from}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section alt topo">
    <div class="wrap two" style="align-items:center">
      <div class="stack">
        <p class="eyebrow">Bringing a baby home soon?</p>
        <h2>Car seat checks in your own driveway</h2>
        <p class="lead">Most parents are not sure their seat is in right. In one visit you install it yourself, in your vehicle, with a certified Child Passenger Safety Technician guiding you.</p>
        <div class="btn-row"><a class="btn" href="/car-seat-installation-bend/">Car seat help in Bend</a></div>
      </div>
      <div class="facts stacked">
        <div><span>Cost</span><b>$50</b></div>
        <div><span>Takes</span><b>45 to 60 minutes</b></div>
        <div><span>Where</span><b>Your home, your vehicle</b></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two" style="align-items:center">
      <div class="stack">
        <p class="eyebrow">Areas served</p>
        <h2>Based in Bend. I come to you.</h2>
        <p class="lead">Visits happen in your home, at the hospital or at a birth center, across Central Oregon.</p>
        <ul class="town-links">
          {townPages.map((t) => <li><a href={`/${t.slug}/`}><b>{t.name}</b><small>about {t.min} min from Bend</small></a></li>)}
        </ul>
      </div>
      <AreaMap />
    </div>
  </section>

  <section class="section alt">
    <div class="wrap two">
      <div class="stack">
        <p class="eyebrow">About Aleah</p>
        <h2>A doula who has been on every side of birth</h2>
        <p class="lead">Mom of two. Two-time surrogate. Trained in early childhood development before any of it.</p>
        <p>I believe every experience is unique and deserves personal, inclusive and non-judgmental care. Whether you are getting ready for birth, finding your way through the first weeks, or facing another big life moment, my job is to help you feel informed and confident.</p>
        <p><a href="/about/">More about Aleah</a></p>
      </div>
      <div class="stack">
        <p class="label">Training and credentials</p>
        <ul class="checks">
          {business.credentials.map((c) => <li>{c}</li>)}
        </ul>
        <div class="note-box">
          <p><b>Your Google reviews go here.</b> Two or three real reviews, with a link to the rest, are one of the quickest ways to build trust.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section cta topo">
    <div class="wrap stack">
      <h2>Ready to talk?</h2>
      <p class="lead" style="max-width:56ch">A free consultation is the easiest way to see if we are a good fit. Oregon Health Plan members can receive birth doula care at no out-of-pocket cost.</p>
      <div class="btn-row">
        <a class="btn" href={business.booking}>Book a free consultation</a>
        <span>or call or text <a href={business.phoneHref}>{business.phone}</a></span>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 72px); align-items: center; padding-block: clamp(36px, 6vw, 80px) clamp(28px, 4vw, 52px); }
  .hero-grid h1 { max-width: 14ch; }
  .hero-grid .lead { max-width: 50ch; }
  .creds { font-size: 14.5px; color: var(--soft); border-top: 1px solid var(--line); padding-top: 16px; }
  .portrait { aspect-ratio: 4 / 5; width: 100%; max-width: 400px; justify-self: end; }
  .facts.stacked { grid-template-columns: 1fr; }
  .facts.stacked > div + div { border-top: 1px solid var(--line); }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; }
    .portrait { aspect-ratio: 16 / 10; max-width: none; justify-self: stretch; }
  }
</style>
