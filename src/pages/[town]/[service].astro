---
// Service pages: /bend/birth-doula/, /bend/car-seat-installation/ and so on.
// Which towns get service pages is set by `serviceTowns` in site.js.
import Base from '../../layouts/Base.astro';
import AreaMap from '../../components/AreaMap.astro';
import Cta from '../../components/Cta.astro';
import { business, services, towns, townServices, region, hasPage, localLine, svcUrl, photoUrl } from '../../data/site.js';

export function getStaticPaths() {
  const out = [];
  for (const t of [region, ...towns]) {
    for (const s of services) {
      if (hasPage(t.slug, s.path)) {
        out.push({ params: { town: t.slug, service: s.path }, props: { s, t } });
      }
    }
  }
  return out;
}
const { s, t } = Astro.props;
// /central-oregon/<service>/ is the main page for each service. Town pages add a local note and a local question.
const isRegion = Boolean(t.region);
const regionTowns = towns.filter((x) => hasPage(x.slug, s.path) && x.slug !== region.slug && x.min !== undefined && ['bend','redmond','sisters','sunriver','la-pine','prineville','madras'].includes(x.slug));
const isBend = t.slug === 'bend';
const local = townServices[t.slug]?.[s.path];
const h1 = isRegion ? `${s.name} in Central Oregon` : `${s.name} in ${t.name}, Oregon`;
const description = isRegion ? s.description.replace('in Bend and Central Oregon', 'across Central Oregon') : isBend ? s.description : s.description.replace(/Bend/g, t.name);
const bendLine = 'Bend is my home base, so visits here are the easiest to schedule and I am close by when you need me.';
const townLine = isBend ? bendLine : isRegion ? '' : localLine(s, t);
let faqs = s.faqs;
if (local?.faq) {
  // Swap the Bend-specific clinic question for the local one, or add it near the top.
  const i = faqs.findIndex((f) => /fire department/i.test(f.q));
  faqs = i >= 0 ? faqs.map((f, j) => (j === i ? local.faq : f)) : [faqs[0], local.faq, ...faqs.slice(1)];
}
if (!isRegion) {
  faqs = [
    { q: `Do you offer ${s.name.toLowerCase()} in ${t.name}?`, a: isBend ? `Yes. ${bendLine}` : `Yes. ${t.name} is about ${t.min} minutes from my home base in Bend. ${townLine}` },
    ...faqs.filter((f) => f.q !== 'What areas do you serve?'),
  ];
}
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: h1,
  description,
  provider: { '@type': 'LocalBusiness', name: business.name, telephone: business.phone },
  areaServed: isRegion ? 'Central Oregon' : `${t.name}, Oregon`,
};
const crumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: Astro.site.href },
    { '@type': 'ListItem', position: 2, name: t.name, item: new URL(`/${t.slug}/`, Astro.site).href },
    { '@type': 'ListItem', position: 3, name: s.name },
  ],
};
const others = services.filter((o) => o.path !== s.path).slice(0, 4);
const ordered = ['car-seat-installation', 'placenta-encapsulation', 'abortion-doula-support'].includes(s.path);
---
<Base title={`${h1} | ${business.name}`} description={description} schema={[serviceSchema, faqSchema, crumbs]} service={s.path} town={isRegion ? '' : t.name}>
  <section class="page-hero">
    <div class="wrap hero-split">
      <div class="stack">
        <p class="eyebrow"><a href="/">Home</a> / <a href={`/${t.slug}/`}>{t.name}</a> / {s.nav}</p>
        <h1>{h1}</h1>
        <p class="lead">{s.summary}</p>
        <Cta />
      </div>
      <img class="hero-photo" src={photoUrl(s.photo, 1100, 800)} alt={s.photo.alt} width="1100" height="800" />
    </div>
    <div class="wrap">
      <div class="facts">
        {s.facts.map(([k, v]) => <div><span>{k}</span><b>{v}</b></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap two">
      <div class="stack">
        {s.intro.map((p, i) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}
        {isRegion && (
          <div class="local stack">
            <p class="eyebrow">Where I offer this</p>
            <p>I offer this across Central Oregon, in {regionTowns.map((x, i, a) => <><a href={`/${x.slug}/${s.path}/`}>{x.name}</a>{i < a.length - 2 ? ', ' : i === a.length - 2 ? ' and ' : ''}</>)}, and the smaller towns in between. Visits happen where you are.</p>
          </div>
        )}
        {!isRegion && (
          <div class="local stack">
            <p class="eyebrow">In {t.name}</p>
            <p>{townLine}</p>
            {local?.note && <p>{local.note}</p>}
          </div>
        )}
        <div class="photo-row" style="margin-block:8px">
          {s.gallery.slice(0, 2).map((ph) => <img src={photoUrl(ph, 800, 600)} alt={ph.alt} width="800" height="600" loading="lazy" />)}
        </div>
        <h2>{s.includesTitle}</h2>
        <ul class={ordered ? 'steps' : 'plain-list'}>
          {s.includes.map(([k, d]) => <li><b>{k}</b><span class="soft">{d}</span></li>)}
        </ul>
        {(s.sections || []).map((sec) => (
          <>
            <h2 style="margin-top:20px">{sec.title}</h2>
            {sec.pairs && <ul class="plain-list">{sec.pairs.map(([k, d]) => <li><b>{k}</b><span class="soft">{d}</span></li>)}</ul>}
            {sec.groups && sec.groups.map((g) => (
              <div class="stack" style="gap:6px">
                <h3 style="font-size:21px;margin-top:10px">{g.h}</h3>
                <ul class="checks small">{g.items.map((i) => <li>{i}</li>)}</ul>
              </div>
            ))}
            {sec.list && <ul class="checks small cols">{sec.list.map((i) => <li>{i}</li>)}</ul>}
          </>
        ))}
      </div>
      <aside class="price-card sticky">
        <p class="eyebrow">Pricing</p>
        <table class="price-table">
          <tbody>
            {s.pricing.map(([name, price, note]) => (
              <tr>
                <td>{name}{note && <small>{note}</small>}</td>
                <td>{price}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="soft" style="font-size:15.5px">HSA and FSA accepted. A superbill is available for insurance.</p>
        <a class="btn" href={business.booking}>Book a free consultation</a>
        <a class="btn ghost" href="#get-started">Send a request</a>
        <p class="soft" style="font-size:15px;text-align:center">or call or text <a href={business.phoneHref}>{business.phone}</a></p>
      </aside>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap two">
      <div class="stack">
        <p class="eyebrow">Good to know</p>
        <h2>Common questions</h2>
        <img class="side-photo" src={photoUrl(s.gallery[2], 800, 600)} alt={s.gallery[2].alt} width="800" height="600" loading="lazy" />
      </div>
      <div class="faq">
        {faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack">
      <p class="eyebrow">Areas served</p>
      <h2>{s.nav} across Central Oregon</h2>
      <div class="two" style="align-items:center">
        <ul class="town-links">
          {towns.map((x) => (
            <li>
              <a href={hasPage(x.slug, s.path) ? `/${x.slug}/${s.path}/` : `/${x.slug}/`}>
                <b>{x.name}</b>
              </a>
            </li>
          ))}
        </ul>
        <AreaMap highlight={isRegion ? undefined : t.name} />
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap stack">
      <p class="eyebrow">Other services in {t.name}</p>
      <ul class="rows">
        {others.map((o) => (
          <li><a href={svcUrl(o, t.slug)}><h3>{o.nav}</h3><p>{o.summary}</p><span class="price">{o.from}</span></a></li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .page-hero { border-bottom: 1px solid var(--line); padding-bottom: clamp(28px, 4vw, 48px); }
  .hero-split { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: center; padding-block: clamp(32px, 5vw, 64px) clamp(24px, 3vw, 40px); }
  .hero-split h1 { max-width: 16ch; }
  .hero-photo { width: 100%; aspect-ratio: 11 / 8; object-fit: cover; background: var(--panel); }
  .sticky { position: sticky; top: 104px; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0 28px; }
  .local { background: var(--panel); padding: 20px 22px; gap: 10px; }
  @media (max-width: 760px) { .hero-split { grid-template-columns: minmax(0, 1fr); } }
</style>
